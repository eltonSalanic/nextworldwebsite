# --- Server ---
SERVER_PORT=3000
# development | production (production enables secure cookies, https reset links, strict CORS)
NODE_ENV=development
# Comma-separated list of frontend origins allowed by CORS
ALLOWED_ORIGINS=http://localhost:5173

# --- Database (PostgreSQL) ---
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nxtworldcollective

# --- Auth ---
# Long random string, e.g. generate with: openssl rand -hex 64
JWT_SECRET=
ACCESS_EXPIRY_MINUTES=15
REFRESH_EXPIRY_DAYS=7
SALT_ROUNDS=10

# --- Email (Gmail via nodemailer) ---
# Password reset page WITHOUT the protocol; http/https is added based on NODE_ENV
FRONTEND_PASSWORD_RESET_URL=localhost:5173/admin/reset-password
# Gmail address that sends reset emails and receives inquiries
FROM_EMAIL=
# Gmail App Access Password (not your normal Gmail password)
EMAIL_PASS=

# --- AWS S3 (image uploads) ---
AWS_S3_REGION=us-east-1
AWS_ACCESS_KEY=
AWS_SECRET_ACCESS_KEY=
AWS_IMAGE_BUCKET=
